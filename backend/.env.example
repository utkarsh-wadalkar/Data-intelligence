DATABASE_URL=mysql+pymysql://user:password@host:port/data_intelligence?ssl_ca=/path/to/ca.pem&ssl_verify_cert=true&ssl_verify_identity=true
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain
OPENROUTER_API_KEY=your_key
OLLAMA_BASE_URL=http://localhost:11434 #if using Ollama, otherwise leave blank
MODEL_PROVIDER=openrouter
ALLOW_PAID_PROVIDERS=false
SPEND_GUARDS_VERIFIED=false
DISPATCH_MODE=local
MODAL_APP_NAME=data-intelligence
FRONTEND_ORIGIN=your_frontend_port
